# ============================================================
#  robot-competition 仓库根忽略规则
#  覆盖 ghr/10.15（主工程）与 xrw/（参考示例）两棵目录树
#  只跟踪源码、工程配置、说明文档
#  编译产物 / 备份快照 / IDE 用户设置 / 密钥 一律不入库
# ============================================================

# ---------- Keil MDK 编译产物 ----------
*.o
*.obj
*.axf
*.elf
*.bin
*.hex
*.crf
*.dep
*.d
*.lnp
*.lst
*.map
*.htm
*.exe
*.i
*.sct
*.bak
*.__i
*.build_log.htm

# ---------- Keil 输出目录（**/ 保证任意层级都匹配）----------
**/OBJ/
**/Objects/
**/Listings/
**/DebugConfig/
**/Debug/
**/Release/
**/RTE/
**/tests/out/

# ---------- Keil / IDE 用户设置（每台机器不同，不共享）----------
*.uvguix.*
*.uvguix
*.uvoptx
*.uvopt
*.scvd
*.dbgconf
*.ats
JLinkSettings.ini

# ---------- 编译型备份目录（历史快照，留在本地即可）----------
**/backup_before_*/
**/backup_*/

# ---------- 临时/杂项 ----------
*.tmp
*.log
*.zip
*.rar
*.7z
Thumbs.db
desktop.ini
~$*
JLinkLog.txt

# ---------- 密钥/凭证：绝对不入库 ----------
.git-ssh/
.ssh-key/
.ssh/
*id_ed25519*
*id_rsa*
*.pem
known_hosts

# ---------- Python（上位机 ghr/10.15/上位机）----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---------- DSH 沙箱 ACL 恢复记录（临时）----------
.acl-recovery/

# ---------- 上位机协议主机侧测试产物（.exe/.o 已被上面规则覆盖）----------
**/Test/host_protocol/frames.txt
*.pdb

# ---------- 大模型权重 / 数据集：不入库（GitHub 单文件硬上限 100MB）----------
# new_eye/models/sam_b.pt 约 358MB，只能本地保留
**/models/
*.pt
*.pth
*.onnx
*.safetensors
*.gguf

# ---------- Qwen 视觉工程运行环境：本地约 33GB，全部不入库 ----------
# Qwen/.gitignore 已经忽略这些目录，这里再兜一层防止误 add
Qwen/.venv/
Qwen/cache/
Qwen/downloads/
Qwen/runtime/
Qwen/home/
Qwen/logs/
Qwen/__pycache__/

# ---------- 构建中转目录：build/ 只是 ghr/10.19 的副本 + Keil 编译日志 ----------
build/

# ---------- 运行时日志（诊断截图 / 回读记录等）----------
**/logs/

# ---------- new_eye GUI 运行时输出：每帧覆写 seq/ts，只留本地 ----------
new_eye/runtime/latest_targets.json
# final 是自包含发布目录：允许 final 内的 SAM 权重入库（用 Git LFS 存大文件）
!final/new_eye/models/
!final/new_eye/models/sam_b.pt
# 大件二进制：模型权重不进 git 历史（物理备份 / 后续 LFS）
10.21/vision/models/
01-交付包/vision/models/
*.pt
*.onnx

