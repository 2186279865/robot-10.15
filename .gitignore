# ============================================================
#  robot-competition 仓库根忽略规则
#  覆盖 ghr/10.15（主工程）与 xrw/（参考示例）两棵目录树
#  只跟踪源码、工程配置、说明文档
#  编译产物 / 备份快照 / IDE 用户设置 / 密钥 一律不入库
# ============================================================

# ---------- Keil MDK 编译产物 ----------
*.o
*.obj
*.axf
*.elf
*.bin
*.hex
*.crf
*.dep
*.d
*.lnp
*.lst
*.map
*.htm
*.exe
*.i
*.sct
*.bak
*.__i
*.build_log.htm

# ---------- Keil 输出目录（**/ 保证任意层级都匹配）----------
**/OBJ/
**/Objects/
**/Listings/
**/DebugConfig/
**/Debug/
**/Release/
**/RTE/
**/tests/out/

# ---------- Keil / IDE 用户设置（每台机器不同，不共享）----------
*.uvguix.*
*.uvguix
*.uvoptx
*.uvopt
*.scvd
*.dbgconf
*.ats
JLinkSettings.ini

# ---------- 编译型备份目录（历史快照，留在本地即可）----------
**/backup_before_*/
**/backup_*/

# ---------- 临时/杂项 ----------
*.tmp
*.log
*.zip
*.rar
*.7z
Thumbs.db
desktop.ini
~$*
JLinkLog.txt

# ---------- 密钥/凭证：绝对不入库 ----------
.git-ssh/
.ssh-key/
.ssh/
*id_ed25519*
*id_rsa*
*.pem
known_hosts

# ---------- Python（上位机 ghr/10.15/上位机）----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---------- DSH 沙箱 ACL 恢复记录（临时）----------
.acl-recovery/
