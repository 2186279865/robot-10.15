
# ---------- Git LFS：final 里的 SAM 权重 ----------
final/new_eye/models/*.pt filter=lfs diff=lfs merge=lfs -text

# 交付包里的 SAM 权重同样走 LFS（默认被 .gitignore 排除，手动 add 时才用）
01-交付包/vision/models/*.pt filter=lfs diff=lfs merge=lfs -text

# ---------- 派端（Linux）脚本必须是 LF ----------
# 否则 /bin/sh 会因行尾 \r 报 "bad interpreter: /bin/sh^M"
*.sh text eol=lf
01-交付包/orangepi/** text eol=lf

# ---------- 二进制/烧录产物：禁止行尾规范化 ----------
*.hex  -text
*.bin  -text
*.axf  -text
*.stl  -text